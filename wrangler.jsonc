/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-27",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * QUÉ HACE: Define los Custom Domains para multi-tenancy.
	 * POR QUÉ: Permite que el Worker responda en dominios específicos sin comodines.
	 * CUIDADO: No usar barras ni comodines al final del patrón.
	 */
	"routes": [
		{ "pattern": "api.integrales.com.ar", "custom_domain": true },
		{ "pattern": "api.brotalia.com.ar", "custom_domain": true }
	],
	"vars": {
		"SUPABASE_URL": "https://afzkyxpyoxafoqldfwjf.supabase.co"
	}
}
