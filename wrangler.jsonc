{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-27",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "api.brotalia.com.ar",
			"custom_domain": true
		}
	],
	"vars": {
		"SUPABASE_URL": "https://afzkyxpyoxafoqldfwjf.supabase.co"
	},
	"kv_namespaces": [
		{
			"binding": "PRICING_CACHE",
			"id": "4605ee2ecc9a4b3c81dc8a713167d1b4"
		}
	]
}